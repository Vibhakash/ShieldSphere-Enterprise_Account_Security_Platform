# Production deployment values used by Docker Compose and the backend.
# Copy this file to backend/.env.production for deployment. Never commit that copy.
APP_DOMAIN=api.security.example.com
FRONTEND_ORIGIN=https://security.example.com
ACME_EMAIL=security-operations@example.com

POSTGRES_USER=shieldsphere
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-database-password
POSTGRES_DB=shieldsphere
REDIS_PASSWORD=replace-with-a-long-alphanumeric-redis-password

# Direct backend URLs are useful for local/non-Compose execution.
# Docker Compose overrides these two values with its internal service addresses.
DATABASE_URL=postgresql+psycopg://shieldsphere:replace-me@127.0.0.1:5432/shieldsphere
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_ENV=production
CORS_ORIGINS=https://security.example.com
ALLOWED_HOSTS=api.security.example.com,backend,localhost,127.0.0.1
TRUSTED_PROXY_NETWORKS=172.30.0.0/24
API_DOCS_ENABLED=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Passkeys are created by the frontend, so these values use its hostname/origin.
WEBAUTHN_RP_ID=security.example.com
WEBAUTHN_RP_NAME=ShieldSphere
WEBAUTHN_ORIGIN=https://security.example.com
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

GROQ_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEOLITE2_DB_PATH=/app/data/GeoLite2-City.mmdb

# Leave all four identity/credential fields empty to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

SANDBOX_NETWORK_INTERNET_EGRESS=false
